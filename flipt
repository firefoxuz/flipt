#!/bin/bash
# Flipt — translates the selected text with Claude and, once approved, puts it in place.
#
#   flipt              translate the selected text into the configured language (the hotkey runs this)
#   flipt <language>   one-off translation into another language, e.g.: flipt Russian
#   flipt --settings   settings window: languages, model and translation rules (extra prompt)
#   flipt --tray       top-bar icon with a menu (started automatically at login by the installer)
#   flipt --tray-stop  remove the top-bar icon
#   flipt --about      "About" window
#   flipt --clear-history   delete the translation history
#   flipt --show       print the current settings
#   flipt --stdin      translate stdin to stdout (no windows)

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/flipt"
CONF="$CONF_DIR/config.conf"
CLAUDE="$HOME/.local/bin/claude"

DEFAULT_LANG="English"
DEFAULT_MODEL="sonnet"
DEFAULT_UI_LANG="en"
DEFAULT_LANG2=""           # reverse language for the automatic direction; empty = off
DEFAULT_AUTO_REPLACE="no"  # yes = paste straight away, without the approval window
DEFAULT_HISTORY="yes"      # yes = keep the last translations (top-bar icon → History)

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/flipt"
HISTORY_FILE="$DATA_DIR/history.jsonl"
HISTORY_MAX=30

VERSION="1.1"
WEBSITE="https://github.com/firefoxuz/flipt"
AUTHOR="Daler Sultonov"

# Target languages offered in the settings window (any other name can be typed in).
LANGS=(English Russian Uzbek Turkish German Arabic)

# Interface languages: "code|name shown in the settings window".
# To add one: add a line here and a matching block in load_messages / show_help.
UI_LANGS=(
    "en|English"
    "uz|O'zbekcha"
    "ru|Русский"
)

# Models offered in the settings window: "model ID|display name".
# Names without a version (haiku, sonnet, ...) always resolve to the newest model of that family.
