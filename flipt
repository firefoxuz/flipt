TRAY_PID="${XDG_RUNTIME_DIR:-/tmp}/flipt-tray.pid"

tray_pid() {  # prints the PID of a running tray, if any
    local pid
    pid=$(cat "$TRAY_PID" 2>/dev/null) || return 1
    [ -n "$pid" ] && grep -qa -- '--flipt-tray' "/proc/$pid/cmdline" 2>/dev/null && echo "$pid"
}

tray_stop() {
    local pid
    pid=$(tray_pid) && kill "$pid" 2>/dev/null
    rm -f "$TRAY_PID"
}

tray() {
    local pid key self
    # One icon is enough. ($$ is our own PID when the tray restarts itself after a config change.)
    pid=$(tray_pid) && [ "$pid" != "$$" ] && exit 0
    self=$(readlink -f "$0")
    for key in "${!M[@]}"; do export "FLIPT_T_$key=${M[$key]}"; done
    echo $$ > "$TRAY_PID"

    # exec keeps the PID, so the PID file stays valid.
    mkdir -p "$DATA_DIR"
    exec python3 - --flipt-tray "$self" "$CONF" "$ICON_SYMBOLIC" "$ICON_SYMBOLIC_DIR" "$HISTORY_FILE" "$LANG2" \
        "$TARGET_LANG" "${LANGS[@]}" 2>/dev/null <<'PYTRAY'
