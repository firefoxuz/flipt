        tray_stop; exit 0 ;;
    --set-lang)
        new=$(printf '%s' "$2" | tr -d '\n=')
        if [ -n "$new" ] && [ "$new" != "$TARGET_LANG" ]; then
            # Picking the reverse language as the target swaps the two.
            [ "$new" = "$LANG2" ] && LANG2="$TARGET_LANG"
            TARGET_LANG="$new"
            write_conf
        fi
        exit 0 ;;
    --stream-raw)   # internal: used by the approval window
        if [ -n "${FLIPT_TARGET:-}" ]; then TARGET_LANG="$FLIPT_TARGET"; LANG2="${FLIPT_LANG2:-}"; fi
        stream_raw; exit $? ;;
    --copy)         # internal: used by the top-bar menu; stdin = text
        clip_set && notify "$(msg copied)"; exit 0 ;;
    --clear-history)
        rm -f "$HISTORY_FILE"; exit 0 ;;
    --show)
        echo "Config: $CONF"; echo "LANG=$TARGET_LANG"; echo "LANG2=$LANG2"; echo "MODEL=$MODEL"
        echo "UI_LANG=$UI_LANG"; echo "AUTO_REPLACE=$AUTO_REPLACE"; echo "HISTORY=$HISTORY"
        echo "PROMPT:"; if [ -n "$EXTRA_PROMPT" ]; then printf '%s\n' "$EXTRA_PROMPT" | sed 's/^/  /'; else echo "  $(msg empty)"; fi
        exit 0 ;;
    --stdin)
        if [ -n "$2" ]; then TARGET_LANG="$2"; LANG2=""; fi
        translate; exit $? ;;
    -h|--help)
        show_help; exit 0 ;;
    -*)
        echo "$(msg unknown_opt "$1")" >&2; exit 2 ;;
    ?*)
        TARGET_LANG="$1"; LANG2="" ;;   # one-off language: no automatic direction
esac

# --- Main mode: selected text → translation → approval → paste in place -------------------------

text=$(sel_get)
if [ -z "${text//[[:space:]]/}" ]; then
    notify "$(msg select_first)"
    exit 1
fi

# Find out where the text came from while that window still has focus.
in_terminal=no
is_terminal && in_terminal=yes

if is_yes "$AUTO_REPLACE"; then
    notify "$(msg translating "$TARGET_LANG")"
    final=$(printf '%s' "$text" | translate)
    if [ -z "$final" ]; then
        notify "$(msg no_reply)"
        exit 1
    fi
else
    final=$(approve "$text") || exit 0
    [ -z "${final//[[:space:]]/}" ] && exit 0
fi

history_add "$text" "$final"

old_clip=$(clip_get)
printf '%s' "$final" | clip_set

sleep 0.4   # wait for focus to return to the original window
if ! send_paste "$in_terminal"; then
    notify "$(msg paste_failed)"
    exit 0
fi

# Restore the previous clipboard.
sleep 0.5
[ -n "$old_clip" ] && printf '%s' "$old_clip" | clip_set
