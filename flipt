# Opens at once and shows the translation as it arrives. "Translate again" asks for another
# variant. Prints the (possibly edited) text; a non-zero exit status means cancelled.
approve() {  # $1 = original text
    local title="$TARGET_LANG"
    [ -n "$LANG2" ] && title="$TARGET_LANG ⇄ $LANG2"
    # The window starts "flipt --stream-raw", which must translate into the same languages
    # (they differ from the config for a one-off "flipt <language>").
    FLIPT_SOURCE="$1" FLIPT_TARGET="$TARGET_LANG" FLIPT_LANG2="$LANG2" python3 - \
        "$(msg confirm_title "$title")" "$(msg replace)" "$(msg cancel)" "$(msg again)" \
        "$(msg busy)" "$(msg no_reply)" "$ICON" "$(readlink -f "$0")" 2>/dev/null <<'PYOK'
import json, os, subprocess, sys, threading
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

title, ok_label, cancel_label, again_label, busy_text, error_text, icon, flipt = sys.argv[1:9]
source = os.environ.get("FLIPT_SOURCE", "")
result = {}
state = {"run": 0, "raw": "", "proc": None, "busy": False, "done": 0}

OPEN, CLOSE = "<translation>", "</translation>"

def visible(raw, final=False):
    """The part of the reply to show: the contents of the last <translation> block."""
    start = raw.rfind(OPEN)
    if start >= 0:
        body = raw[start + len(OPEN):]
    elif final or not OPEN.startswith(raw.lstrip()[:len(OPEN)]):
        body = raw            # the model answered without tags
    else:
        return ""             # the opening tag is still arriving
    end = body.find(CLOSE)
    if end >= 0:
        body = body[:end]
    elif not final:           # hide a closing tag that has only partly arrived
        for k in range(len(CLOSE) - 1, 0, -1):
            if body.endswith(CLOSE[:k]):
                body = body[:-k]
                break
    body = body.lstrip("\n")
    return body.rstrip() if final else body

PAD = 8          # inner margin around the text
MIN_W = 360      # keeps the title and buttons readable for a one-word translation
MAX_W, MAX_H = 900, 600   # upper limits for the text area, further capped to 60% of the screen

win = Gtk.Window(title=title)
win.set_icon_name(icon)
win.set_border_width(12)

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
win.add(box)

view = Gtk.TextView()
view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
view.set_left_margin(PAD); view.set_right_margin(PAD)
view.set_top_margin(PAD); view.set_bottom_margin(PAD)
buf = view.get_buffer()

display = Gdk.Display.get_default()
monitor = display.get_primary_monitor() or display.get_monitor(0)
if monitor is not None:
    geo = monitor.get_geometry()
    MAX_W = min(MAX_W, int(geo.width * 0.6))
    MAX_H = min(MAX_H, int(geo.height * 0.6))

scroll = Gtk.ScrolledWindow()
scroll.set_shadow_type(Gtk.ShadowType.IN)
scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
scroll.set_vexpand(True)
scroll.add(view)
box.pack_start(scroll, True, True, 0)

size = {"w": 0, "h": 0}

def fit(text):
    """Size the text area to `text`: as wide as its longest line and as tall as it wraps to,
    within the limits. It only ever grows, so the window does not jump around."""
    layout = view.create_pango_layout(text)
    natural_w, _ = layout.get_pixel_size()
    text_w = max(MIN_W, min(natural_w + 4, MAX_W), size["w"])
    layout.set_wrap(Pango.WrapMode.WORD_CHAR)
    layout.set_width(text_w * Pango.SCALE)
    _, wrapped_h = layout.get_pixel_size()
    text_h = max(min(wrapped_h + 4, MAX_H), size["h"])
    size["w"], size["h"] = text_w, text_h
    # With no horizontal scrollbar GTK ignores min-content-width, so the width is a size request.
    scroll.set_size_request(text_w + 2 * PAD + 2, -1)
    scroll.set_min_content_height(text_h + 2 * PAD)

fit(source)   # the translation is about as long as the original

bottom = Gtk.Box(spacing=8)
spinner = Gtk.Spinner()
status = Gtk.Label(xalign=0)
status.get_style_context().add_class("dim-label")
again = Gtk.Button(label=again_label)
cancel = Gtk.Button(label=cancel_label)
ok = Gtk.Button(label=ok_label)
ok.get_style_context().add_class("suggested-action")
bottom.pack_start(spinner, False, False, 0)
bottom.pack_start(status, True, True, 0)
bottom.pack_start(again, False, False, 0)
bottom.pack_start(cancel, False, False, 0)
bottom.pack_start(ok, False, False, 0)
box.pack_start(bottom, False, False, 0)

def set_busy(busy):
    state["busy"] = busy
    view.set_editable(not busy)
    ok.set_sensitive(not busy)
    again.set_sensitive(not busy)
    status.set_text(busy_text if busy else "")
    if busy:
        spinner.start()
    else:
        spinner.stop()

def stop():
    proc = state["proc"]
    if proc is not None and proc.poll() is None:
        proc.kill()

def on_delta(run, piece):
    if run == state["run"]:
        state["raw"] += piece
        buf.set_text(visible(state["raw"]))
    return False

def on_done(run, final):
    if run != state["run"] or state["done"] == run:
        return False
    state["done"] = run
    text = visible(final if final is not None else state["raw"], final=True)
    buf.set_text(text)
    set_busy(False)
    if text:
        fit(text)
        ok.grab_focus()      # Enter replaces straight away; click into the text to edit it first
    else:
        ok.set_sensitive(False)
        status.set_text(error_text)
        again.grab_focus()
    return False

def start(previous=""):
    stop()
    state["run"] += 1
    run = state["run"]
    state["raw"] = ""
    buf.set_text("")
    set_busy(True)
    env = dict(os.environ)
    env["FLIPT_PREVIOUS"] = previous
    proc = subprocess.Popen([flipt, "--stream-raw"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, env=env)
    state["proc"] = proc

    def work():
        final = None
        try:
            proc.stdin.write(source.encode())
            proc.stdin.close()
            for line in proc.stdout:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                kind = event.get("type")
                if kind == "stream_event":
                    inner = event.get("event", {})
                    delta = inner.get("delta", {})
                    if inner.get("type") == "content_block_delta" and delta.get("type") == "text_delta":
                        GLib.idle_add(on_delta, run, delta.get("text", ""))
                    elif inner.get("type") == "message_stop":
                        # The reply is complete; claude itself takes another second to exit.
                        GLib.idle_add(on_done, run, None)
                elif kind == "result" and not event.get("is_error") and isinstance(event.get("result"), str):
                    final = event["result"]
        except OSError:
            pass
        proc.wait()
        GLib.idle_add(on_done, run, final)

    threading.Thread(target=work, daemon=True).start()

def current_text():
    return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)

def accept(*_):
    if not state["busy"] and current_text().strip():
        result["text"] = current_text()
        win.destroy()

def on_key(_w, ev):
    if ev.keyval == Gdk.KEY_Escape:
        win.destroy()
    elif ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ev.state & Gdk.ModifierType.CONTROL_MASK:
        accept()
    else:
        return False
    return True

def on_destroy(*_):
    stop()
    Gtk.main_quit()

ok.connect("clicked", accept)
cancel.connect("clicked", lambda *_: win.destroy())
again.connect("clicked", lambda *_: start(current_text()))
win.connect("key-press-event", on_key)
win.connect("destroy", on_destroy)

win.show_all()
win.present()
start()
Gtk.main()

if "text" not in result:
    sys.exit(1)
sys.stdout.write(result["text"])
PYOK
}

